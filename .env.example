# Copy this file to .env and provide the JWT configuration.
Jwt__Key=
Jwt__Issuer=
Jwt__Audience=
Jwt__ExpiryMinutes=60

# One-time initial admin bootstrap. Set Enabled=true for the first startup
# only when the database has no Admin account, then disable it and remove the password.
InitialAdmin__Enabled=false
InitialAdmin__Email=admin@techwave.com
InitialAdmin__Password=Admin@123
InitialAdmin__EmployeeCode=Emp001
InitialAdmin__Name=Admin
InitialAdmin__Department=Administration
